generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  employeeId   String        @unique
  email        String        @unique
  passwordHash String
  name         String
  role         String        @default("EMPLOYEE") // "ADMIN" or "EMPLOYEE"
  department   String        @default("Engineering")
  position     String        @default("Software Developer")
  avatarUrl    String?
  phone        String?
  address      String?
  joinDate     DateTime      @default(now())
  baseSalary   Float         @default(65000)

  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  payrolls      Payroll[]
  documents     Document[]
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  employee   User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       String    // YYYY-MM-DD format
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LEAVE
  totalHours Float     @default(0)
}

model LeaveRequest {
  id           String   @id @default(uuid())
  employeeId   String
  employee     User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    String   // PAID, SICK, UNPAID
  startDate    String   // YYYY-MM-DD
  endDate      String   // YYYY-MM-DD
  remarks      String?
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminComment String?
  createdAt    DateTime @default(now())
}

model Payroll {
  id         String   @id @default(uuid())
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      String
  year       Int
  baseSalary Float
  allowances Float    @default(0)
  deductions Float    @default(0)
  netSalary  Float
  status     String   @default("PAID")
  createdAt  DateTime @default(now())
}

model Document {
  id         String   @id @default(uuid())
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  fileUrl    String
  fileType   String   @default("PDF")
  uploadedAt DateTime @default(now())
}
