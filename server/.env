# Dayflow HRMS Backend Environment Variables

# Prisma PostgreSQL connection string (Supabase)
# Find this in your Supabase Project Settings -> Database -> Connection string -> URI
# Make sure to replace [YOUR-PASSWORD] with your actual database password
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres"

# JWT Secret for authentication
JWT_SECRET="dayflow-hrms-super-secret-key-change-in-production"

# Server Port
PORT=5000
